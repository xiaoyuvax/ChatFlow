<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows7.0;net9.0-windows7.0;net8.0-windows7.0;net7.0-windows7.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>13</LangVersion>
    <RootNamespace>ChatFlow</RootNamespace>
    <AssemblyName>ChatFlow</AssemblyName>
    <Version>0.1.11</Version>
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <!-- FCTB 只消费 NuGet 包：源码/包两套身份会让同一份 ChatFlow 代码在不同机器上编出不同依赖闭包。 -->
  <ItemGroup>
    <PackageReference Include="Vax-FCTB" Version="2.19.0.228" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net7.0-windows7.0'">
    <PackageReference Include="CDS.Markdown.Lite" Version="1.5.7" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChatFlow.Tests" />
  </ItemGroup>

</Project>
