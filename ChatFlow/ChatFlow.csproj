<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows7.0;net9.0-windows7.0;net8.0-windows7.0;net7.0-windows7.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>13</LangVersion>
    <RootNamespace>ChatFlow</RootNamespace>
    <AssemblyName>ChatFlow</AssemblyName>
    <Version>0.1.1</Version>
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vax-FCTB" Version="2.19.0.224" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChatFlow.Tests" />
  </ItemGroup>

</Project>
